# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 说明：开源版本身不含 /api/interpret、/api/heming 等后端接口。本仓库已按
# README「快速开始」自建了这两个接口（见 app/api/ 与 lib/ai/），因此下面这组
# 配置填好并重启 npm run dev 后即可启用 AI 解读与合盘分析；
# 排盘、看命盘不需要任何 API Key。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
# 可选覆盖（不填则用内置默认 https://api.deepseek.com/v1 + deepseek-chat）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 或用 openai / 其他 OpenAI 兼容服务 ───
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# 自定义服务也可写 AI_PROVIDER=<名称>，再配 <名称>_API_KEY / <名称>_BASE_URL / <名称>_MODEL

# ─── 通用覆盖项（任意 provider 均可，优先级最高）───
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000